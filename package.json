{
  "name": "yutverse-online",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @yutverse/web -- --host 0.0.0.0",
    "build": "npm run check -w @yutverse/server && npm run build -w @yutverse/web",
    "test": "tsx --test packages/engine/src/*.test.ts apps/server/src/*.test.ts scripts/*.test.mjs apps/web/src/*.test.ts",
    "dev:server": "npm run dev -w @yutverse/server",
    "start": "npm start -w @yutverse/server",
    "test:browser": "node scripts/browser-smoke.cjs",
    "tunnel:install": "sh scripts/install-cloudflared.sh",
    "deploy:quick": "node scripts/deploy-quick.mjs",
    "tunnel:install:mac": "node scripts/install-cloudflared-mac.mjs",
    "test:game-view": "node scripts/game-view-smoke.cjs",
    "test:animation": "node scripts/animation-smoke.cjs",
    "test:rules-browser": "node scripts/rules-browser-smoke.cjs",
    "test:characters-browser": "node scripts/characters-browser-smoke.cjs",
    "test:accounts-browser": "node scripts/accounts-browser-smoke.cjs",
    "test:rooms-browser": "node scripts/rooms-browser-smoke.cjs",
    "test:online-layout": "node scripts/online-layout-smoke.cjs",
    "test:recovery-browser": "node scripts/recovery-browser-smoke.cjs",
    "test:turn-augments": "node scripts/turn-augments-browser-smoke.cjs",
    "test:family-browser": "node scripts/family-browser-smoke.cjs",
    "test:game-style": "node scripts/game-style-browser-smoke.cjs",
    "test:catalog-browser": "node scripts/catalog-browser-smoke.cjs",
    "reports:list": "node scripts/reports.mjs list",
    "reports:show": "node scripts/reports.mjs show",
    "reports:export": "node scripts/reports.mjs export",
    "test:pages-browser": "node scripts/pages-browser-smoke.cjs"
  },
  "devDependencies": {
    "playwright": "^1.65.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
